<Window x:Class="MediaGrab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaGrab"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>

            <TextBlock
            Text="Media URL"
            Margin="0,0,0,5" />

            <TextBox
            x:Name="UrlTextBox"
            Height="30"
            Margin="0,0,0,10" />

            <TextBlock
            Text="Save to"
            Margin="0,5,0,5" />

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                x:Name="OutputFolderTextBox"
                Grid.Column="0"
                Height="30"
                IsReadOnly="True"
                VerticalContentAlignment="Center"
                Margin="0,0,10,0" />

                <Button
                Grid.Column="1"
                x:Name="BrowseButton"
                Content="Browse..."
                Width="90"
                Height="30"
                Click="BrowseButton_Click" />
            </Grid>

            <Button
            x:Name="DownloadButton"
            Content="Download MP3"
            Height="35"
            Click="DownloadButton_Click"
            Margin="0,0,0,20" />
            <Button
            x:Name="OpenFolderButton"
            Content="Open Download Folder"
            Height="30"
            Click="OpenFolderButton_Click"
            Margin="0,0,0,20" />

            <TextBlock
            x:Name="StatusTextBlock"
            Text="Ready"
            Margin="0,0,0,5" />

            <ProgressBar
            x:Name="DownloadProgressBar"
            Height="20"
            Minimum="0"
            Maximum="100"
            Value="0"
            Margin="0,0,0,5" />

            <TextBlock
            x:Name="ProgressDetailsTextBlock"
            HorizontalAlignment="Right" />

        </StackPanel>
    </Grid>
</Window>
